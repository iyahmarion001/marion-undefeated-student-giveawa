# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PERSISTENT MANAGED DATABASE (PostgreSQL / Neon / Supabase / Vercel Postgres / Cloud SQL)
# When set, all student registrations, sharing confirmations, and campaign records
# persist permanently to your managed database.
DATABASE_URL="postgresql://username:password@hostname:5432/database_name?sslmode=require"

# ADMIN AUTHENTICATION
# Custom secure passcode for the private administrator console login
ADMIN_PASSWORD="REPLACE_WITH_SECURE_ADMIN_PASSWORD"

# ADMIN SESSION SIGNING SECRET (Optional, Recommended)
# Persistent server-side secret used to sign admin session tokens via HMAC-SHA256 across all Vercel serverless instances
# If not provided, the HMAC signing key is automatically derived from ADMIN_PASSWORD
ADMIN_SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET_KEY"

# WHATSAPP NOTIFICATION RECIPIENT
# Administrator phone number formatted with country code (e.g. 2348057231961 for 08057231961)
ADMIN_WHATSAPP="2348057231961"
ADMIN_WHATSAPP_NUMBER="2348057231961"

# DIRECT WHATSAPP BUSINESS CLOUD API (Official Meta Graph API)
# Used to dispatch direct registration notifications to the administrator without redirecting the student
WHATSAPP_ACCESS_TOKEN="EAA..."
WHATSAPP_PHONE_NUMBER_ID="10..."

# OPTIONAL: TWILIO WHATSAPP API (Alternative provider)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_WHATSAPP_NUMBER="+14155238886"
